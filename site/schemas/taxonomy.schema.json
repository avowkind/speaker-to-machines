{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Speaker-to-Machines taxonomy file (data/taxonomy.yaml)",
  "type": "object",
  "required": ["categories"],
  "additionalProperties": false,
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "subcategories"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "subcategories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": { "name": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  }
}
